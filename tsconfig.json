{
    "compilerOptions": {
        "baseUrl": "src/",
        "outDir": "dist/",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "pretty": true,
        "removeComments": false,
        "sourceMap": true,
        "target": "ESNext",
        "typeRoots" : [
            "./node_modules/@types",
            "./typings"
        ]
    }
}