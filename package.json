{
	"name": "tea",
	"version": "1.0.0",
	"description": "A Boilerplate Code for a Express App with support of Typescript.",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"start": "node --env-file .env ./dist/bin/server.js",
		"dev": "node --env-file .env --watch ./dist/bin/server.js",
		"format": "prettier --write --ignore-unknown \"src/**/*.ts\"",
		"pre-commit": "tsc --noEmit --pretty && lint-staged",
		"lint": "eslint \"{src,test}/**/*.ts\" --fix",
		"prepare": "husky"
	},
	"repository": "https://github.com/akgurjar/TEA.git",
	"author": "ashish gurjar <ashishkgurjar@gmail.com>",
	"license": "GPL-3.0",
	"private": false,
	"imports": {
		"#app/*": "./dist/app/*.js",
		"#api/*": "./dist/app/api/*.js",
		"#utils/*": "./dist/utils/*.js",
		"#database/*": "./dist/database/*.js",
		"#constants/*": "./dist/app/constants/*.js",
		"#middlewares/*": "./dist/app/middlewares/*.js"
	},
	"lint-staged": {
		"*.{ts,js}": [
			"prettier --write \"src/**/*.ts\"",
			"eslint \"{src,test}/**/*.ts\" --fix"
		]
	},
	"dependencies": {
		"cookie-parser": "^1.4.7",
		"ejs": "^3.1.10",
		"express": "^5.0.1",
		"i18n": "^0.15.1",
		"joi": "^17.13.3",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^8.8.1",
		"nodemailer": "^6.9.16",
		"serve-favicon": "^2.5.0",
		"twilio": "^5.3.5",
		"winston": "^3.17.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.14.0",
		"@types/cookie-parser": "^1.4.7",
		"@types/ejs": "^3.1.5",
		"@types/express": "^5.0.0",
		"@types/joi": "^17.2.3",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/mongoose": "^5.11.97",
		"@types/node": "^22.9.0",
		"@types/nodemailer": "^6.4.16",
		"@types/serve-favicon": "^2.5.7",
		"eslint": "^9.14.0",
		"husky": "^9.1.6",
		"lint-staged": "^15.2.10",
		"prettier": "^3.3.3",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.13.0"
	}
}
