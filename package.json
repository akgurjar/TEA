{
  "name": "tea",
  "version": "1.0.0",
  "description": "A Boilerplate Code for a Express App with support of Typescript.",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production ts-node -r tsconfig-paths/register ./src/bin/server.ts --fast",
    "dev": "NODE_ENV=development ts-node -r tsconfig-paths/register ./src/bin/server.ts --fast",
    "stag": "NODE_ENV=stagging ts-node -r tsconfig-paths/register ./src/bin/server.ts --fast",
    "local": "NODE_ENV=local ts-node-dev -r tsconfig-paths/register ./src/bin/server.ts",
    "lint": "tslint -p tsconfig.json"
  },
  "repository": "https://github.com/akgurjar/TEA.git",
  "author": "ashish gurjar <ashishkgurjar@gmail.com>",
  "license": "GPL-3.0",
  "private": false,
  "imports": {
    "#app/*": [
      "src/app/*"
    ],
    "@api/*": [
      "src/app/api/*"
    ],
    "@utils/*": [
      "src/utils/*"
    ],
    "@database/*": [
      "src/database/*"
    ],
    "@constants/*": [
      "src/app/constants/*"
    ],
    "@validators/*": [
      "src/app/validators/*"
    ],
    "@middlewares/*": [
      "src/app/middlewares/*"
    ]
  },
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/debug": "^4.1.12",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/serve-favicon": "^2.5.7",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.3",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "serve-favicon": "^2.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^6.1.3",
    "twilio": "^5.2.2",
    "typescript": "^5.5.4",
    "uuid": "^10.0.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "ts-node-dev": "^1.1.8"
  }
}
