<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Typescript Express App</title>
		<style>
			html,
			body {
				height: 100%;
			}
			body {
				margin: 0;
				background-color: #f1f1f1;
				font-family:
					system-ui,
					-apple-system,
					BlinkMacSystemFont,
					'Segoe UI',
					Roboto,
					Oxygen,
					Ubuntu,
					Cantarell,
					'Open Sans',
					'Helvetica Neue',
					sans-serif;
				--primary-color-500: #34495e;
			}
			main {
				min-height: calc(100% - 64px);
				width: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
			}
		</style>
	</head>
	<body>
		<%- include('partials/header') %>
		<main style="flex-direction: column">
			<p>You are logged in now !</p>
		</main>
		<style></style>
	</body>
</html>
